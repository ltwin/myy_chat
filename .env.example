# MyY Chat AI角色对话平台 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ============================================
# Snowflake ID 分布式ID生成配置
# ============================================
# 数据中心ID (0-31)
DATACENTER_ID=1
# 工作节点ID (0-31)
WORKER_ID=1
# Kubernetes环境下,WORKER_ID会从Pod名称动态生成

# ============================================
# 数据库配置
# ============================================
# PostgreSQL 主数据库
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=myy_chat
POSTGRES_USER=myy_chat_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_MIN_CONNECTIONS=10

# PostgreSQL 连接字符串
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis 缓存与会话
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ============================================
# JWT 认证配置
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_DAYS=7

# ============================================
# LLM 供应商配置
# ============================================
# Azure OpenAI (主供应商)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_MODEL=gpt-4-turbo

# Claude (备用供应商)
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# LiteLLM 路由配置
LLM_PRIMARY_PROVIDER=azure_openai
LLM_FALLBACK_PROVIDER=anthropic
LLM_CIRCUIT_BREAKER_THRESHOLD=3
LLM_CIRCUIT_BREAKER_TIMEOUT=10

# ============================================
# Embedding 服务配置
# ============================================
# SiliconFlow API (MVP阶段)
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_ENDPOINT=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-m3

# 本地Embedding (生产环境可选)
# USE_LOCAL_EMBEDDING=true
# LOCAL_EMBEDDING_MODEL_PATH=/models/bge-m3

# ============================================
# 服务端口配置
# ============================================
# Golang 微服务 gRPC 端口
USER_SERVICE_GRPC_PORT=50051
CHARACTER_SERVICE_GRPC_PORT=50052
CONVERSATION_SERVICE_GRPC_PORT=50053
MEMORY_SERVICE_GRPC_PORT=50054
BILLING_SERVICE_GRPC_PORT=50055
ADMIN_SERVICE_GRPC_PORT=50056
ANALYTICS_SERVICE_GRPC_PORT=50057

# Golang 微服务 HTTP 端口 (可选,用于健康检查)
USER_SERVICE_HTTP_PORT=8051
CHARACTER_SERVICE_HTTP_PORT=8052
CONVERSATION_SERVICE_HTTP_PORT=8053
MEMORY_SERVICE_HTTP_PORT=8054
BILLING_SERVICE_HTTP_PORT=8055
ADMIN_SERVICE_HTTP_PORT=8056
ANALYTICS_SERVICE_HTTP_PORT=8057

# Python 微服务端口
LLM_SERVICE_GRPC_PORT=50061
LLM_SERVICE_HTTP_PORT=8061
MEMORY_PROCESSOR_GRPC_PORT=50062
MEMORY_PROCESSOR_HTTP_PORT=8062
COMPRESSION_SERVICE_GRPC_PORT=50063
COMPRESSION_SERVICE_HTTP_PORT=8063

# Frontend 前端端口
NEXT_PUBLIC_FRONTEND_PORT=3000

# API Gateway 网关端口
API_GATEWAY_HTTP_PORT=8080

# ============================================
# Kafka 消息队列 (生产环境)
# ============================================
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=myy_chat_consumer
# MVP阶段使用 Redis Streams 替代

# ============================================
# 对象存储配置
# ============================================
# MinIO (自托管)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=myy-chat-assets
MINIO_USE_SSL=false

# AWS S3 (云端部署)
# S3_REGION=us-east-1
# S3_BUCKET=myy-chat-prod
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ============================================
# 可观测性配置
# ============================================
# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=myy-chat
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# Jaeger (分布式追踪)
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Prometheus (指标监控)
PROMETHEUS_PUSHGATEWAY=http://localhost:9091

# ============================================
# 应用配置
# ============================================
# 运行环境 (development, staging, production)
NODE_ENV=development
GO_ENV=development
PYTHON_ENV=development

# 日志级别 (debug, info, warn, error)
LOG_LEVEL=info

# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# 积分系统
INITIAL_CREDITS=100
TOKEN_TO_CREDIT_RATIO=1000

# 会话配置
SESSION_TTL_HOURS=24
TEMPORARY_MEMORY_TTL_HOURS=24

# ============================================
# 前端环境变量 (NEXT_PUBLIC_ 开头)
# ============================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_APP_NAME=MyY Chat
NEXT_PUBLIC_APP_DESCRIPTION=AI角色对话平台

# ============================================
# 安全配置
# ============================================
# CORS 允许的来源
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# 密码哈希 bcrypt rounds
BCRYPT_COST=12

# ============================================
# 开发工具配置
# ============================================
# 启用调试模式
DEBUG=false

# 启用 gRPC reflection (仅开发环境)
GRPC_REFLECTION_ENABLED=true

# 启用 Swagger UI (仅开发环境)
SWAGGER_ENABLED=true
