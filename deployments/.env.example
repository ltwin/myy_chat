# MyY Chat 开发环境配置
# 复制此文件为 .env 并填写实际值

# ============================================
# PostgreSQL
# ============================================
POSTGRES_DB=myy_chat
POSTGRES_USER=myy_chat_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# ============================================
# Redis
# ============================================
REDIS_PORT=6379

# ============================================
# MinIO (对象存储)
# ============================================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ============================================
# JWT 认证
# ============================================
JWT_SECRET=change_me_in_production_use_a_long_random_string

# ============================================
# Snowflake ID
# ============================================
DATACENTER_ID=1

# ============================================
# LiteLLM Proxy
# ============================================
LITELLM_MASTER_KEY=sk-myy-chat-dev-key

# ============================================
# LLM Provider API Keys
# ============================================

# Azure OpenAI (主要)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Anthropic Claude (备用)
ANTHROPIC_API_KEY=

# Google Gemini (备用)
GEMINI_API_KEY=

# OpenAI Direct (可选)
OPENAI_API_KEY=

# ============================================
# Neo4j (知识图谱 - 可选)
# ============================================
NEO4J_PASSWORD=change_me_in_production

# ============================================
# 可观测性 (可选)
# ============================================
GRAFANA_PASSWORD=admin
