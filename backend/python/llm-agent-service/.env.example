# LLM Agent Service Environment Variables

# Service Configuration
LLM_AGENT_SERVICE_NAME=llm-agent-service
LLM_AGENT_DEBUG=false

# Server Ports
LLM_AGENT_HTTP_PORT=8080
LLM_AGENT_GRPC_PORT=50051

# LiteLLM Proxy Configuration
LLM_AGENT_LITELLM_PROXY_URL=http://litellm:4000
LLM_AGENT_LITELLM_API_KEY=

# Redis Configuration
LLM_AGENT_REDIS_URL=redis://redis:6379

# Database Configuration (read-only for context)
LLM_AGENT_DATABASE_URL=postgresql://postgres:password@postgres:5432/myychat

# Observability
LLM_AGENT_OTEL_ENABLED=false
LLM_AGENT_OTEL_ENDPOINT=http://jaeger:4317

# Rate Limiting
LLM_AGENT_RATE_LIMIT_REQUESTS=100
LLM_AGENT_RATE_LIMIT_WINDOW=60
