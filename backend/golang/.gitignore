# Reference https://github.com/github/gitignore/blob/master/Go.gitignore
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work

# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.o
*.a
*.so

# OS General
Thumbs.db
.DS_Store

# project
*.cert
*.key
*.log
bin/

# Proto generated code (protoc 自动生成，不提交)
*.pb.go
*_grpc.pb.go
*_http.pb.go
*.pb.validate.go

# Wire generated code (依赖注入自动生成)
wire_gen.go

# OpenAPI generated (Proto 生成的 OpenAPI spec)
openapi.yaml

# Test coverage
coverage.out
coverage.html

# Develop tools
.vscode/
.idea/
*.swp
